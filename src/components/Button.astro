---
// 紺地・白文字・角丸のボタン(リンク)。1ページにつき最大でも1つ
interface Props {
  href: string;
  ariaDisabled?: boolean;
}
const { href, ariaDisabled } = Astro.props;
---

<a class="button" href={href} aria-disabled={ariaDisabled ? "true" : undefined}>
  <slot />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-min);
    padding: 12px 28px;
    border-radius: var(--radius-pill);
    background: var(--color-navy);
    color: var(--color-bg);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .button:hover {
    color: var(--color-bg);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .button[aria-disabled="true"] {
    opacity: 0.6;
    pointer-events: none;
  }
</style>
