---
import { Image } from "astro:assets";
import { render } from "astro:content";
import PageHead from "../components/PageHead.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getMembers, getPage } from "../lib/content";
import { pick, t, type Lang } from "../lib/i18n";
import { href } from "../lib/url";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ja = lang === "ja";
const entry = await getPage("message", lang);
const { Content } = await render(entry);
const m = entry.data;
const faculty = (await getMembers()).find((x) => x.data.role === "faculty");
const name = faculty ? pick(faculty.data.name, lang) : "";
---

<BaseLayout lang={lang} title={t(lang, "nav.message")} path="/message/">
  <PageHead label="Message" title={m.title} />
  <section class="container layout">
    <div class="side">
      {faculty?.data.photo ? (
        <Image class="photo" src={faculty.data.photo} alt="" width={336} />
      ) : (
        <div class="photo placeholder">{ja ? "[写真]" : "[Photo]"}</div>
      )}
      <p class="sub small">{faculty && pick(faculty.data.title, lang)}</p>
      <p class="name">{name}</p>
      <a class="text-link" href={href("/members/", lang)}>
        {ja ? "プロフィール" : "Profile"} →
      </a>
    </div>
    <div class="body">
      <p class="opening">{m.opening}</p>
      <div class="prose">
        <Content />
      </div>
      <p class="signature sub">
        {m.date} {name}
      </p>
      <div class="next">
        <a class="text-link" href={href("/research/", lang)}>
          {ja ? "研究を見る" : "Research"} →
        </a>
        <a class="text-link" href={href("/join/", lang)}>
          {t(lang, "nav.join")} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .layout {
    padding-top: 72px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px 48px;
  }
  .side {
    flex: 1 1 200px;
  }
  .photo {
    width: 168px;
    height: 210px;
    border-radius: var(--radius-card);
    object-fit: cover;
  }
  .placeholder {
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: var(--color-text-sub);
  }
  .small {
    margin: 16px 0 0;
    font-size: 14px;
  }
  .name {
    margin: 0;
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 0.08em;
  }
  .body {
    flex: 999 1 560px;
    min-width: 0;
    max-width: var(--measure);
    font-size: 17px;
    line-height: 2.05;
  }
  .opening {
    margin: 0;
    font-size: 21px;
    line-height: 1.8;
    font-weight: 500;
    letter-spacing: 0.05em;
  }
  .prose :global(h2) {
    margin: 56px 0 0;
    font-size: 19px;
    letter-spacing: 0.06em;
  }
  .prose :global(p) {
    margin: 16px 0 0;
  }
  .signature {
    margin: 48px 0 0;
    text-align: right;
    font-size: 15px;
  }
  .next {
    margin-top: 72px;
    padding-top: 32px;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
  }
  .next a {
    font-size: 15px;
  }
</style>
