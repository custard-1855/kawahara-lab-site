---
import Button from "../components/Button.astro";
import Hero from "../components/Hero.astro";
import ListRow from "../components/ListRow.astro";
import Section from "../components/Section.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate } from "../lib/articles";
import { getArticles, getMembers, getPage, getThemes } from "../lib/content";
import { pick, t, type Lang } from "../lib/i18n";
import { articleHref, href } from "../lib/url";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const home = (await getPage("home", lang)).data;
const message = (await getPage("message", lang)).data;
const themes = await getThemes();
const faculty = (await getMembers()).find((m) => m.data.role === "faculty");
const latest = (await getArticles()).slice(0, 3);
const ja = lang === "ja";
const guideHref = (anchor: string) =>
  anchor === "members" ? href("/members/", lang) : href(`/join/#${anchor}`, lang);
---

<BaseLayout lang={lang} path="/">
  <section class="container top">
    <Hero />
    <div class="intro">
      <div class="copy">
        <h1>{home.catchcopy}</h1>
        <p class="lead">{home.lead}</p>
      </div>
      <Button href={href("/join/", lang)}>
        {ja ? "配属を考えている人へ" : "For Prospective Students"}
      </Button>
    </div>
  </section>

  <Section title={t(lang, "nav.message")} label="Message">
    <div class="message">
      <p class="summary">{message.summary}</p>
      <div class="sign">
        <span class="sub">
          {faculty && `${pick(faculty.data.title, lang) ?? ""} ${pick(faculty.data.name, lang)}`}
        </span>
        <a class="text-link" href={href("/message/", lang)}>
          {t(lang, "common.readAll")} →
        </a>
      </div>
    </div>
  </Section>

  <Section title={t(lang, "nav.research")} label="Research">
    <div class="rule-list">
      {themes.map((theme) => (
        <ListRow href={href(`/research/#${theme.id}`, lang)} lead={32} pad={24}>
          <span slot="lead">{String(theme.data.order).padStart(2, "0")}</span>
          <span class="theme">
            <span class="theme-name">{pick(theme.data.name, lang)}</span>
            <span class="theme-summary">{pick(theme.data.summary, lang)}</span>
          </span>
        </ListRow>
      ))}
    </div>
    <div class="below">
      <span class="sub">{t(lang, "common.placeholderNote")}</span>
      <a class="text-link" href={href("/publications/", lang)}>
        {t(lang, "nav.publications")} →
      </a>
    </div>
  </Section>

  <Section title={ja ? "配属を考えている人へ" : "For Students"} label="For Students">
    <div class="cards">
      {home.guides.map((g) => (
        <a class="card" href={guideHref(g.anchor)}>
          <span class="card-title">{g.title}</span>
          <span class="card-desc">{g.desc}</span>
        </a>
      ))}
    </div>
    <p class="visit sub">{home.visitNote}</p>
  </Section>

  <Section title={t(lang, "nav.articles")} label="Articles">
    <div class="rule-list">
      {latest.map((a) => (
        <ListRow href={href(articleHref(a.id))} hreflang={ja ? undefined : "ja"}>
          <span slot="lead">{formatDate(a.date)}</span>
          <span lang={ja ? undefined : "ja"}>{a.title}</span>
          <span slot="meta">
            {t(lang, `category.${a.category}`)}
            {!ja && <span class="ja-only"> · {t(lang, "common.japaneseOnly")}</span>}
          </span>
        </ListRow>
      ))}
    </div>
    <div class="below right">
      <a class="text-link" href={href("/articles/")}>
        {t(lang, "common.allArticles")} →
      </a>
    </div>
  </Section>
</BaseLayout>

<style>
  .top {
    padding-top: 40px;
  }
  .intro {
    padding-top: 56px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: flex-end;
  }
  .copy {
    flex: 999 1 520px;
    min-width: 0;
  }
  h1 {
    margin: 0;
    font-size: calc(var(--font-size-h1) + 2px);
    line-height: 1.5;
    letter-spacing: 0.06em;
  }
  .lead {
    margin: 16px 0 0;
    color: var(--color-text-sub);
    max-width: 36em;
  }
  .message {
    max-width: var(--measure);
  }
  .summary {
    margin: 0;
    font-size: 17px;
    line-height: 2;
  }
  .sign {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    font-size: 14px;
  }
  .theme {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 24px;
  }
  .theme-name {
    flex: 0 0 180px;
    font-size: 18px;
    font-weight: 500;
  }
  .theme-summary {
    flex: 999 1 280px;
    min-width: 0;
    font-size: 15px;
    color: var(--color-text-sub);
  }
  .below {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    font-size: 14px;
  }
  .below.right {
    justify-content: flex-end;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 12px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--color-surface);
    border-radius: var(--radius-card);
    padding: 24px 28px;
    color: var(--color-text);
    text-decoration: none;
  }
  .card:hover .card-title {
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .card-title {
    font-size: 17px;
    font-weight: 500;
  }
  .card-desc {
    font-size: 14px;
    color: var(--color-text-sub);
    line-height: 1.8;
  }
  .visit {
    margin: 20px 0 0;
    font-size: 14px;
  }
</style>
