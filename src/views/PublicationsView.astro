---
// 業績。全件を1ページに出し、種別の絞り込みは小さな素の JavaScript で hidden を切り替える。
// JavaScript が無効なら全件を表示し、絞り込みのボタンは出さない
import PageHead from "../components/PageHead.astro";
import PubEntry from "../components/PubEntry.astro";
import Section from "../components/Section.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate } from "../lib/articles";
import { getMembers, getPubs, researchmapFetchedAt } from "../lib/content";
import { t, type Lang } from "../lib/i18n";
import { countByType, groupByYear, PUB_TYPES, yearOf } from "../lib/pubs";
import { SITE } from "../site.config";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = (await getPubs()).filter((p) => yearOf(p) >= SITE.pubsFromYear);
const groups = groupByYear(all);
const counts = countByType(all);
const faculty = (await getMembers()).find((m) => m.data.role === "faculty" && m.data.researchmap);
const researchmapUrl = faculty ? `https://researchmap.jp/${faculty.data.researchmap}` : undefined;
const fetched = researchmapFetchedAt
  ? t(lang, "pubs.fetchedAt").replace("{date}", formatDate(new Date(researchmapFetchedAt)))
  : t(lang, "pubs.notFetched");
const filters = ["all", ...PUB_TYPES] as const;
---

<BaseLayout
  lang={lang}
  title={t(lang, "nav.publications")}
  path="/publications/"
  current="publications"
>
  <PageHead label="Publications" title={t(lang, "nav.publications")}>
    <p class="lead">
      {t(lang, "pubs.lead")}
      <b>{t(lang, "pubs.boldNote")}</b>
    </p>
    <p class="fetched sub">{fetched}</p>
    <div class="controls">
      <div class="filters" role="group" aria-label={t(lang, "pubs.filter")} data-filters hidden>
        {filters.map((f) => (
          <button type="button" data-filter={f} aria-pressed={f === "all" ? "true" : "false"}>
            {t(lang, `pubs.label.${f}`)} <span class="count mono">{counts[f]}</span>
          </button>
        ))}
      </div>
      <nav class="years mono" aria-label={t(lang, "pubs.jumpYear")}>
        {groups.map((g) => (
          <a href={`#y${g.year}`}>{g.year}</a>
        ))}
      </nav>
    </div>
  </PageHead>

  {groups.length === 0 && (
    <Section gap={64}>
      <p class="empty">{t(lang, "pubs.empty")}</p>
    </Section>
  )}
  {groups.map((g) => (
    <Section id={`y${g.year}`} title={String(g.year)} numeric gap={64}>
      <div data-year>
        <p class="empty" data-empty hidden>
          {t(lang, "pubs.empty")}
        </p>
        <ol class="rule-list">
          {g.items.map((p) => (
            <li class="item" data-type={p.type}>
              <span class="type sub">{t(lang, `pubs.label.${p.type}`)}</span>
              <div class="entry">
                <PubEntry pub={p} lang={lang} />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </Section>
  ))}

  <Section gap={72}>
    <div class="more sub">
      {researchmapUrl && (
        <>
          <a class="text-link" href={researchmapUrl}>
            {t(lang, "pubs.more")} →
          </a>
          <p>{t(lang, "pubs.researchmapNote")}</p>
        </>
      )}
    </div>
  </Section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-filters]");
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("button[data-filter]")];
    const items = [...document.querySelectorAll<HTMLElement>("li[data-type]")];
    const years = [...document.querySelectorAll<HTMLElement>("[data-year]")];
    const apply = (filter: string) => {
      for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.filter === filter));
      for (const li of items) li.hidden = filter !== "all" && li.dataset.type !== filter;
      for (const y of years) {
        const visible = y.querySelectorAll("li[data-type]:not([hidden])").length;
        y.querySelector<HTMLElement>("[data-empty]")!.hidden = visible > 0;
      }
    };
    for (const b of buttons) b.addEventListener("click", () => apply(b.dataset.filter!));
    root.hidden = false;
  }
</script>

<style>
  .lead {
    margin: 12px 0 0;
    color: var(--color-text-sub);
    max-width: var(--measure);
  }
  .lead b {
    color: var(--color-text);
  }
  .fetched {
    margin: 4px 0 0;
    font-size: 13px;
  }
  .controls {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-line);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .filters[hidden] {
    display: none;
  }
  button {
    font: inherit;
    font-size: 14px;
    letter-spacing: 0.03em;
    border: 0;
    cursor: pointer;
    min-height: var(--tap-min);
    border-radius: var(--radius-pill);
    padding: 10px 20px;
    background: var(--color-surface);
    color: var(--color-text);
  }
  button[aria-pressed="true"] {
    background: var(--color-navy);
    color: var(--color-bg);
  }
  .count {
    font-size: 12px;
    opacity: 0.75;
  }
  .years {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
    font-size: 13px;
  }
  .years a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-text-sub);
  }
  .item {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .item[hidden] {
    display: none;
  }
  .type {
    flex: 0 0 88px;
    font-size: 13px;
    padding-top: 2px;
  }
  .entry {
    flex: 999 1 380px;
    min-width: 0;
  }
  .more p {
    margin: 8px 0 0;
    font-size: 14px;
  }
</style>
