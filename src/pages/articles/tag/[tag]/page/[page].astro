---
import type { GetStaticPaths } from "astro";
import { paginate } from "../../../../../lib/articles";
import { getArticles, getTagIndex } from "../../../../../lib/content";
import { tagHref } from "../../../../../lib/url";
import { SITE } from "../../../../../site.config";
import ArticlesView from "../../../../../views/ArticlesView.astro";

export const getStaticPaths = (async () => {
  const all = await getArticles();
  return (await getTagIndex()).all().flatMap(({ id }) =>
    paginate(
      all.filter((a) => a.tags.includes(id)),
      SITE.articlesPerPage,
    )
      .slice(1)
      .map((p) => ({ params: { tag: id, page: String(p.page) }, props: { tag: id, ...p } })),
  );
}) satisfies GetStaticPaths;

const { tag, items, page, lastPage } = Astro.props;
---

<ArticlesView items={items} page={page} lastPage={lastPage} listPath={tagHref(tag)} tag={tag} />
