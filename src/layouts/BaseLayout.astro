---
// 全ページの土台: <head>、ヘッダー、フッター
import "@fontsource/ibm-plex-sans-jp/400.css";
import "@fontsource/ibm-plex-sans-jp/500.css";
import "@fontsource/ibm-plex-sans-jp/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/tokens.css";
import "../styles/base.css";
import Footer from "../components/Footer.astro";
import Header, { type NavKey } from "../components/Header.astro";
import { t, type Lang } from "../lib/i18n";
import { href, joinBase } from "../lib/url";

interface Props {
  lang: Lang;
  /** ページ名。トップでは省略する */
  title?: string;
  description?: string;
  /** 言語の接頭辞を除いたパス(例: /research/) */
  path: string;
  /** もう一方の言語の同じページがあるか(記事は日本語のみ) */
  hasAlt?: boolean;
  current?: NavKey;
}
const { lang, title, description, path, hasAlt = true, current } = Astro.props;
const siteName = t(lang, "site.name");
const fullTitle = title ? `${title} | ${siteName}` : siteName;
const desc = description ?? t(lang, "site.description");
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = abs(href(path, lang));
const ogImage = abs(joinBase(import.meta.env.BASE_URL, "/og.png"));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {hasAlt && (
      <>
        <link rel="alternate" hreflang="ja" href={abs(href(path, "ja"))} />
        <link rel="alternate" hreflang="en" href={abs(href(path, "en"))} />
        <link rel="alternate" hreflang="x-default" href={abs(href(path, "ja"))} />
      </>
    )}
    <link
      rel="icon"
      type="image/svg+xml"
      href={joinBase(import.meta.env.BASE_URL, "/favicon.svg")}
    />
    <link rel="sitemap" href={joinBase(import.meta.env.BASE_URL, "/sitemap-index.xml")} />
    <meta property="og:type" content={path === "/" ? "website" : "article"} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "ja" ? "ja_JP" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">
      {lang === "ja" ? "本文へ移動" : "Skip to content"}
    </a>
    <Header lang={lang} path={path} hasAlt={hasAlt} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 8px;
    top: -100px;
    z-index: 10;
    padding: 8px 16px;
    background: var(--color-navy);
    color: var(--color-bg);
    border-radius: var(--radius-pill);
  }
  .skip:focus {
    top: 8px;
  }
  main {
    display: block;
    padding-bottom: 136px;
  }
</style>
