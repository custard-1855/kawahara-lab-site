---
// 記事ページ: パンくず、H1、著者・日付・分類・タグ、目次(H2から生成)、本文、著者紹介、関連記事
import "katex/dist/katex.min.css";
import { render } from "astro:content";
import ListRow from "../components/ListRow.astro";
import Section from "../components/Section.astro";
import { formatDate, relatedArticles } from "../lib/articles";
import { getArticles, getTagIndex, type Article } from "../lib/content";
import { pick, t } from "../lib/i18n";
import { articleHref, categoryHref, href, tagHref } from "../lib/url";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  article: Article;
}
const { article } = Astro.props;
const { Content, headings } = await render(article.entry);
const toc = headings.filter((h) => h.depth === 2 && h.text !== "参考文献");
const tags = await getTagIndex();
const related = relatedArticles(article, await getArticles(), 3);
const author = article.author.data;
const category = t("ja", `category.${article.category}`);
---

<BaseLayout
  lang="ja"
  title={article.title}
  description={article.excerpt}
  path={articleHref(article.id)}
  hasAlt={false}
  current="articles"
>
  <article>
    <header class="container head">
      <nav class="crumbs sub" aria-label="パンくず">
        <a href={href("/articles/")}>記事</a> /{" "}
        <a href={href(categoryHref(article.category))}>{category}</a>
      </nav>
      <h1>{article.title}</h1>
      <div class="meta sub">
        <span class="author">
          <span class="avatar" aria-hidden="true"></span>
          <span class="author-name">{pick(author.name, "ja")}</span>
          {author.grade}
        </span>
        <time class="mono" datetime={formatDate(article.date)}>
          {formatDate(article.date)}
        </time>
        <span>{category}</span>
        <span class="tags">
          {article.tags.map((s) => (
            <a href={href(tagHref(s))}>#{tags.nameOf(s)}</a>
          ))}
        </span>
      </div>
    </header>

    <div class="container layout">
      <aside class="toc">
        {toc.length > 0 && (
          <nav aria-labelledby="toc-label">
            <p class="toc-label mono" id="toc-label">
              Contents
            </p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}
      </aside>
      <div class="body">
        <div class="prose">
          <Content />
        </div>
        <div class="profile">
          <div class="avatar large" aria-hidden="true"></div>
          <div class="profile-body">
            <p class="mono profile-label">Author</p>
            <p class="profile-name">
              {pick(author.name, "ja")} <span class="sub">{author.grade}</span>
            </p>
            {author.bio && <p class="profile-bio sub">{pick(author.bio, "ja")}</p>}
            <div class="profile-links">
              <a class="text-link" href={href("/members/")}>
                メンバー紹介 →
              </a>
              {author.links.map((l) => (
                <a class="text-link" href={l.url}>
                  {l.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <Section title="関連する記事" label="Related" gap={104}>
      <div class="rule-list">
        {related.map((a) => (
          <ListRow href={href(articleHref(a.id))}>
            <span slot="lead">{formatDate(a.date)}</span>
            {a.title}
            <span slot="meta">{t("ja", `category.${a.category}`)}</span>
          </ListRow>
        ))}
      </div>
    </Section>
  )}
</BaseLayout>

<style>
  .head {
    padding-top: 72px;
  }
  .crumbs {
    font-size: 13px;
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-text-sub);
  }
  h1 {
    margin: 8px 0 0;
    max-width: 24em;
    font-size: var(--font-size-h1);
    line-height: 1.55;
    letter-spacing: 0.05em;
  }
  .meta {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 24px;
    font-size: 14px;
  }
  .author {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .author-name {
    color: var(--color-text);
  }
  .avatar {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-surface);
  }
  .avatar.large {
    width: 64px;
    height: 64px;
  }
  .meta time {
    font-size: 13px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 12px;
  }
  .tags a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-text-sub);
  }
  .layout {
    padding-top: 72px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px 48px;
  }
  .toc {
    flex: 1 1 200px;
    font-size: 14px;
  }
  .toc nav {
    position: sticky;
    top: 24px;
  }
  .toc-label {
    margin: 0;
    font-size: 12px;
    color: var(--color-text-sub);
  }
  .toc ol {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--color-line);
  }
  .toc a {
    display: block;
    padding: 6px 0 6px 16px;
    color: var(--color-text-sub);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--color-navy);
  }
  .body {
    flex: 999 1 560px;
    min-width: 0;
    max-width: var(--measure);
  }
  .profile {
    margin-top: 72px;
    padding-top: 32px;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .profile-body {
    flex: 1 1 260px;
    min-width: 0;
  }
  .profile p {
    margin: 0;
  }
  .profile-label {
    font-size: 12px;
    color: var(--color-text-sub);
  }
  .profile-name {
    font-weight: 500;
  }
  .profile-name .sub {
    font-weight: 400;
    font-size: 14px;
  }
  .profile-bio {
    margin-top: 6px !important;
    font-size: 14px;
    line-height: 1.8;
  }
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
  }

  /* 本文(Markdown から生成した HTML) */
  .prose {
    font-size: 16.5px;
    line-height: 2;
  }
  .prose :global(h2) {
    margin: 64px 0 0;
    font-size: var(--font-size-h2);
    letter-spacing: 0.06em;
    scroll-margin-top: 24px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    margin: 40px 0 0;
    font-size: 18px;
  }
  .prose :global(p) {
    margin: 16px 0 0;
  }
  .prose :global(.katex-display) {
    margin: 20px 0 12px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 4px 0;
  }
  .prose :global(pre) {
    margin: 20px 0 0;
    padding: 20px 24px;
    background: var(--color-code-bg) !important;
    color: var(--color-code-text);
    border-radius: 12px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.75;
    letter-spacing: 0;
  }
  .prose :global(pre:focus-visible) {
    outline: 2px solid var(--color-link);
  }
  .prose :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-surface);
    padding: 1px 6px;
    border-radius: 6px;
  }
  .prose :global(.figure) {
    margin: 28px 0 0;
  }
  .prose :global(.figure-body) {
    border-radius: var(--radius-card);
    background: var(--color-surface);
    padding: 28px 24px 20px;
  }
  .prose :global(figcaption) {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.8;
    color: var(--color-text-sub);
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 16px 0 0;
    padding-left: 1.6em;
  }
  /* 参考文献は小さく、薄く */
  .prose :global(h2#参考文献) {
    margin-top: 48px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.03em;
  }
  .prose :global(h2#参考文献 + ol) {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.9;
    color: var(--color-text-sub);
  }
</style>
